          "name": "Query a dataset (JSON)",
          "request": {
            "name": "Query a dataset (JSON)",
            "description": {
              "content": "Returns rows from the specified dataset as JSON. Supports the Socrata\nSODA SoQL query parameters (`$select`, `$where`, `$order`, `$group`,\n`$limit`, `$offset`, `$q`).\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "resource",
                "{{dataset_id}}.json"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "$select",
                  "value": "<string>",
                  "description": "SoQL `$select` clause specifying which columns to return."
                },
                {
                  "disabled": false,
                  "key": "$where",
                  "value": "<string>",
                  "description": "SoQL `$where` filter clause."
                },
                {
                  "disabled": false,
                  "key": "$order",
                  "value": "<string>",
                  "description": "SoQL `$order` clause for sorting results."
                },
                {
                  "disabled": false,
                  "key": "$group",
                  "value": "<string>",
                  "description": "SoQL `$group` clause for aggregations."
                },
                {
                  "disabled": false,
                  "key": "$limit",
                  "value": "<integer>",
                  "description": "Maximum number of rows to return (default 1000, max 50000)."
                },
                {
                  "disabled": false,
                  "key": "$offset",
                  "value": "<integer>",
                  "description": "Row offset for paginating results."
                },
                {
                  "disabled": false,
                  "key": "$q",
                  "value": "<string>",
                  "description": "Full-text search query."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
